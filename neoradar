# --- OUI vendor lookup with cache + API fallback ---
get_vendor() {
    local mac="$1" oui_clean vendor
    [ -z "$mac" ] || [ "$mac" = "Unavailable" ] && { echo "Unknown Vendor"; return; }

    oui_clean=$(echo "$mac" | tr -d ':-' | tr 'a-z' 'A-Z' | cut -c 1-6)

    # Check for randomized/private MAC (mobile privacy feature)
    local first_byte="${oui_clean:0:2}"
    local second_char="${first_byte:1:1}"
    case "$second_char" in
        2|6|A|E) echo "Randomized MAC (Privacy)"; return ;;
    esac

    # Check cache
    [ -n "${OUI_CACHE[$oui_clean]}" ] && { echo "${OUI_CACHE[$oui_clean]}"; return; }

    # Check local OUI file
    if [ -f /usr/share/ieee-data/oui.txt ]; then
        vendor=$(grep -i "^$oui_clean" /usr/share/ieee-data/oui.txt 2>/dev/null | head -1 | cut -d')' -f2 | xargs)
        if [ -n "$vendor" ]; then
            OUI_CACHE[$oui_clean]="$vendor"
            echo "$vendor"
            return
        fi
    fi

    # API fallback
    if command -v curl >/dev/null 2>&1; then
        vendor=$(curl -s --max-time 3 "https://api.maclookup.app/v2/macs/$oui_clean" 2>/dev/null)
        if [ -n "$vendor" ]; then
            vendor=$(echo "$vendor" | grep -o '"company":"[^"]*"' | cut -d'"' -f4)
            if [ -n "$vendor" ]; then
                OUI_CACHE[$oui_clean]="$vendor"
                echo "$vendor"
                return
            fi
        fi
    fi

    echo "Unknown Vendor"
}

# --- Service label for port ---
port_service() {
    case $1 in
        22) echo "SSH" ;; 23) echo "Telnet" ;; 80) echo "HTTP" ;;
        139) echo "NetBIOS" ;; 443) echo "HTTPS" ;; 445) echo "SMB" ;;
        3389) echo "RDP" ;; *) echo "$1" ;;
    esac
}

# --- Multi-signal OS fingerprinting ---
fingerprint_os() {
    local ip="$1" ttl="$2" hname="$3"
    shift 3
    local open_ports=("$@")
    local sw=0 sl=0 sa=0 sn=0 total=0 top=0 pct=0
    local os="Unknown" conf="low" header="" nb="" mac="" oui=""

    # TTL
    if [ "$ttl" -ge 100 ] && [ "$ttl" -le 128 ]; then sw=$((sw + 2))
    elif [ "$ttl" -ge 32 ] && [ "$ttl" -le 64 ]; then sl=$((sl + 2))
    elif [ "$ttl" -ge 240 ] && [ "$ttl" -le 255 ]; then sn=$((sn + 2))
    fi

    # Hostname clues
    if [ -n "$hname" ] && [ "$hname" != "No DNS/mDNS/NBT Record" ] && [ "$hname" != "Unavailable" ]; then
        local hname_upper
        hname_upper=$(echo "$hname" | tr 'a-z' 'A-Z')
        case "$hname_upper" in
            IPHONE*|IPAD*|IPOD*) sa=$((sa + 3)) ;;
            MACBOOK*|MAC-PRO*|IMAC*|MACMINI*) sa=$((sa + 3)) ;;
            DESKTOP-*|LAPTOP-*|WIN-*) sw=$((sw + 1)) ;;
            ANDROID*|SM-*|GT-*|REDMI*|POCO*|MOTO*) sl=$((sl + 2)) ;;
        esac
    fi

    # Ports
    for p in "${open_ports[@]}"; do
        case $p in
            445) sw=$((sw + 3)) ;;
            139|3389) sw=$((sw + 2)) ;;
            22) sl=$((sl + 2)) ;;
            23) sn=$((sn + 1)) ;;
            5000|7000) sa=$((sa + 3)) ;;
            62078) sa=$((sa + 2)) ;;
            5555) sl=$((sl + 2)) ;;
        esac
    done

    # HTTP Server header
    header=$(echo -e "HEAD / HTTP/1.0\r\n\r\n" | timeout 1 nc "$ip" 80 2>/dev/null | grep -i "^Server:" | head -1)
    if [ -n "$header" ]; then
        echo "$header" | grep -qi "Microsoft-IIS" && sw=$((sw + 2))
        echo "$header" | grep -qiE "Apache|nginx" && sl=$((sl + 1))
    fi

    # NetBIOS
    if command -v nmblookup >/dev/null 2>&1; then
        nb=$(nmblookup -A "$ip" 2>/dev/null | grep -E "<00>" | grep -v "<GROUP>" | head -1 | awk '{print $1}')
        [ -n "$nb" ] && sw=$((sw + 3))
    fi

    # MAC OUI hint (weak, +1 only)
    mac=$(get_mac_address "$ip" 2>/dev/null)
    if [ -n "$mac" ] && [ "$mac" != "Unavailable" ]; then
        oui=$(echo "$mac" | tr -d ':-' | tr 'a-z' 'A-Z' | cut -c 1-6)
        case "$oui" in
            000393|000502|000A27|1093E9|A483E7|F4F5DB|\
            147DDA|185AF6|34A395|3CD0F8|685B36|703EAC|\
            784F43|88532C|90840D|94DB49|9801A7|B8E856|\
            C84C75|D89A34|F01898|F09A51|F40F24|FCE998|\
            FC253F|04D3B0|086698) sa=$((sa + 1)) ;;
            0012FB|001599|5001D9|B05CDA|EC1F72|7085C2|\
            001A11|3C5AB4|DAA119|A47733|000F90|182B0A|\
            48FD8E|549F13|001882|3C5C1C|5407CC|DAAEC7|\
            001E66|A8B8E0|DC330D|000FB0|447733|7C610E|\
            9CFCE8|8C5085|0012D2|00150C) sl=$((sl + 1)) ;;
        esac
    fi

    # Determine winner
    total=$((sw + sl + sa + sn))
    [ "$total" -eq 0 ] && { echo "Unknown|low"; return; }

    if [ "$sa" -ge "$sw" ] && [ "$sa" -ge "$sl" ] && [ "$sa" -ge "$sn" ] && [ "$sa" -gt 0 ]; then
        os="Apple (macOS/iOS)"; top=$sa
    elif [ "$sw" -ge "$sl" ] && [ "$sw" -ge "$sn" ] && [ "$sw" -gt 0 ]; then
        os="Windows"; top=$sw
    elif [ "$sl" -ge "$sn" ] && [ "$sl" -gt 0 ]; then
        os="Linux / Android"; top=$sl
    elif [ "$sn" -gt 0 ]; then
        os="Network / IoT Device"; top=$sn
    fi

    pct=$((top * 100 / total))
    [ "$pct" -ge 80 ] && conf="very high"
    [ "$pct" -ge 60 ] && conf="high"
    [ "$pct" -ge 40 ] && conf="medium"

    echo "$os|$conf"
}

# --- Loop-based end options (no recursion) ---
show_end_options() {
    local suppress_save="$1"
    shift
    local output_data=("$@")
    local action=""

    while true; do
        echo ""
        if [ "$suppress_save" = "true" ]; then
            read -r -p "$(echo -e "${CLR_CYAN}[+] Press Enter or 'B' for Main Menu, or 'E' to Exit:${CLR_RESET} ")" action
        else
            read -r -p "$(echo -e "${CLR_CYAN}[+] Press Enter or 'B' for Main Menu, 'S' to Save Scan, or 'E' to Exit:${CLR_RESET} ")" action
        fi

        case "$action" in
            [eE])
                echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"
                exit 0
                ;;
            [sS])
                if [ "$suppress_save" = "true" ]; then
                    start_neo_scanner
                    return
                fi
                if [ "${#output_data[@]}" -eq 0 ]; then
                    echo -e "  ${CLR_YELLOW}[-] No scan results available to save.${CLR_RESET}"
                else
                    local default_file="Scan_Result_$(date +'%Y%m%d_%H%M%S').txt"
                    local file_path=""

                    if command -v zenity >/dev/null 2>&1; then
                        file_path=$(zenity --file-selection --save --confirm-overwrite --filename="$default_file" 2>/dev/null)
                    elif command -v kdialog >/dev/null 2>&1; then
                        file_path=$(kdialog --getsavefilename "$default_file" 2>/dev/null)
                    fi

                    if [ -z "$file_path" ]; then
                        read -r -p "$(echo -e "${CLR_CYAN}Enter save file path (default: $default_file):${CLR_RESET} ")" user_path
                        file_path="${user_path:-$default_file}"
                    fi

                    printf "%s\n" "${output_data[@]}" > "$file_path" 2>/dev/null
                    if [ $? -eq 0 ]; then
                        echo -e "  ${CLR_GREEN}[+] Scan results saved to: $file_path${CLR_RESET}"
                    else
                        echo -e "  ${CLR_RED}[-] Error saving file to $file_path${CLR_RESET}"
                    fi
                fi
                ;;
            [bB]|"")
                start_neo_scanner
                return
                ;;
        esac
    done
}

