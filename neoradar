# ANSI Color Codes
CLR_RESET="\033[0m"
CLR_CYAN="\033[1;36m"
CLR_DARKCYAN="\033[0;36m"
CLR_MAGENTA="\033[1;35m"
CLR_DARKMAGENTA="\033[0;35m"
CLR_YELLOW="\033[1;33m"
CLR_GREEN="\033[1;32m"
CLR_GRAY="\033[0;37m"
CLR_DARKGRAY="\033[1;30m"
CLR_RED="\033[1;31m"

