# --- Termux detection ---
detect_termux() {
    [ -n "$TERMUX_VERSION" ] || [ -f "/system/build.prop" ]
}

# --- IP validation ---
validate_ip() {
    local ip=$1 octets=() octet
    IFS='.' read -ra octets <<< "$ip"
    [ ${#octets[@]} -ne 4 ] && return 1
    for octet in "${octets[@]}"; do
        [[ "$octet" =~ ^[0-9]+$ ]] || return 1
        [ "$octet" -lt 0 -o "$octet" -gt 255 ] && return 1
    done
    return 0
}

# --- Port check (300ms timeout) ---
check_port() {
    local ip="$1" port="$2"
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 1 "$ip" "$port" >/dev/null 2>&1
        return $?
    fi
    timeout 1 bash -c "</dev/tcp/$ip/$port" >/dev/null 2>&1
    return $?
}

# --- Batch port scan for a single host (all ports per call) ---
scan_host_ports() {
    local ip="$1" port
    shift 1
    for port in "$@"; do
        if check_port "$ip" "$port"; then
            echo "$port"
        fi
    done
}

# --- Hostname resolution (multi-method) ---
resolve_hostname() {
    local ip="$1" name=""

    if command -v nmblookup >/dev/null 2>&1; then
        name=$(nmblookup -A "$ip" 2>/dev/null | grep -E "<00>" | grep -v "<GROUP>" | head -1 | awk '{print $1}')
    fi

    if [ -z "$name" ] && command -v avahi-resolve >/dev/null 2>&1; then
        name=$(avahi-resolve -a "$ip" 2>/dev/null | awk '{print $2}')
    fi

    if [ -z "$name" ]; then
        name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
    fi

    if [ -z "$name" ] && command -v nslookup >/dev/null 2>&1; then
        name=$(nslookup "$ip" 2>/dev/null | grep "name = " | sed 's/.*name = //' | sed 's/\.$//' | head -1)
    fi

    if [ -z "$name" ] && command -v dig >/dev/null 2>&1; then
        name=$(dig -x "$ip" +short 2>/dev/null | head -1)
    fi

    if [ -n "$name" ]; then
        echo "$name"
    else
        echo "No DNS/mDNS/NBT Record"
    fi
}

# --- ARP MAC capture ---
get_mac_address() {
    local ip="$1" mac=""

    mac=$(ip neighbor show "$ip" 2>/dev/null | awk '{print $5}' | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'a-z' 'A-Z' | head -1)

    if [ -z "$mac" ] && [ -f /proc/net/arp ]; then
        mac=$(grep -w "$ip" /proc/net/arp 2>/dev/null | awk '{print $4}' | grep -v "00:00:00:00:00:00" | tr 'a-z' 'A-Z' | head -1)
    fi

    if [ -z "$mac" ] && command -v arp >/dev/null 2>&1; then
        mac=$(arp -n "$ip" 2>/dev/null | grep -w "$ip" | awk '{print $3}' | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'a-z' 'A-Z' | head -1)
    fi

    if [ -n "$mac" ]; then
        echo "$mac"
    else
        echo "Unavailable"
    fi
}

