# --- Termux detection ---
detect_termux() {
    [ -n "$TERMUX_VERSION" ] || [ -f "/system/build.prop" ]
}

# --- IP validation ---
validate_ip() {
    local ip=$1 octets=() octet
    IFS='.' read -ra octets <<< "$ip"
    [ ${#octets[@]} -ne 4 ] && return 1
    for octet in "${octets[@]}"; do
        [[ "$octet" =~ ^[0-9]+$ ]] || return 1
        [ "$octet" -lt 0 -o "$octet" -gt 255 ] && return 1
    done
    return 0
}

# --- Port check (300ms timeout) ---
check_port() {
    local ip="$1" port="$2"
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 1 "$ip" "$port" >/dev/null 2>&1
        return $?
    fi
    timeout 1 bash -c "</dev/tcp/$ip/$port" >/dev/null 2>&1
    return $?
}

# --- Batch port scan for a single host (all ports per call) ---
scan_host_ports() {
    local ip="$1" port
    shift 1
    for port in "$@"; do
        if check_port "$ip" "$port"; then
            echo "$port"
        fi
    done
}

# --- Hostname resolution (multi-method) ---
resolve_hostname() {
    local ip="$1" name=""

    if command -v nmblookup >/dev/null 2>&1; then
        name=$(nmblookup -A "$ip" 2>/dev/null | grep -E "<00>" | grep -v "<GROUP>" | head -1 | awk '{print $1}')
    fi

    if [ -z "$name" ] && command -v avahi-resolve >/dev/null 2>&1; then
        name=$(avahi-resolve -a "$ip" 2>/dev/null | awk '{print $2}')
    fi

    if [ -z "$name" ]; then
        name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
    fi

    if [ -z "$name" ] && command -v nslookup >/dev/null 2>&1; then
        name=$(nslookup "$ip" 2>/dev/null | grep "name = " | sed 's/.*name = //' | sed 's/\.$//' | head -1)
    fi

    if [ -z "$name" ] && command -v dig >/dev/null 2>&1; then
        name=$(dig -x "$ip" +short 2>/dev/null | head -1)
    fi

    if [ -n "$name" ]; then
        echo "$name"
    else
        echo "No DNS/mDNS/NBT Record"
    fi
}

# --- ARP MAC capture ---
get_mac_address() {
    local ip="$1" mac=""

    mac=$(ip neighbor show "$ip" 2>/dev/null | awk '{print $5}' | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'a-z' 'A-Z' | head -1)

    if [ -z "$mac" ] && [ -f /proc/net/arp ]; then
        mac=$(grep -w "$ip" /proc/net/arp 2>/dev/null | awk '{print $4}' | grep -v "00:00:00:00:00:00" | tr 'a-z' 'A-Z' | head -1)
    fi

    if [ -z "$mac" ] && command -v arp >/dev/null 2>&1; then
        mac=$(arp -n "$ip" 2>/dev/null | grep -w "$ip" | awk '{print $3}' | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'a-z' 'A-Z' | head -1)
    fi

    if [ -n "$mac" ]; then
        echo "$mac"
    else
        echo "Unavailable"
    fi
}

# --- OUI vendor lookup ---
get_vendor() {
    local mac="$1"
    [ -z "$mac" ] || [ "$mac" = "Unavailable" ] && { echo "Unknown Vendor"; return; }

    local oui_clean
    oui_clean=$(echo "$mac" | tr -d ':-' | tr 'a-z' 'A-Z' | cut -c 1-6)

    if [ -f /usr/share/ieee-data/oui.txt ]; then
        local match
        match=$(grep -i "^$oui_clean" /usr/share/ieee-data/oui.txt 2>/dev/null | head -1 | cut -d')' -f2 | xargs)
        if [ -n "$match" ]; then echo "$match"; return; fi
    fi

    case "$oui_clean" in
        005056|000C29|000569|00155D) echo "VMware / Hyper-V" ;;
        080027|0A0027)             echo "Oracle VirtualBox" ;;
        B827EB|D43A04|E45F01|2CCF67) echo "Raspberry Pi" ;;
        001A11|3C5AB4|F4F5DB|DAA119) echo "Google" ;;
        000393|000502|A483E7|1093E9) echo "Apple" ;;
        50C7BF|E848B8|001D0F|98DAC4) echo "TP-Link" ;;
        00146C|00184D|288023|A42B8C) echo "NETGEAR" ;;
        00166F|001E64|A44E31|8086F2) echo "Intel" ;;
        *)                          echo "Unknown Vendor ($oui_clean)" ;;
    esac
}

# --- Service label for port ---
port_service() {
    case $1 in
        22) echo "SSH" ;; 23) echo "Telnet" ;; 80) echo "HTTP" ;;
        139) echo "NetBIOS" ;; 443) echo "HTTPS" ;; 445) echo "SMB" ;;
        3389) echo "RDP" ;; *) echo "$1" ;;
    esac
}

# --- Multi-signal OS fingerprinting ---
fingerprint_os() {
    local ip="$1" ttl="$2"
    shift 2
    local open_ports=("$@")
    local sw=0 sl=0 sn=0 total=0 top=0 pct=0
    local os="Unknown" conf="low" header="" nb=""

    # TTL
    if [ "$ttl" -ge 100 ] && [ "$ttl" -le 128 ]; then sw=$((sw + 2))
    elif [ "$ttl" -ge 32 ] && [ "$ttl" -le 64 ]; then sl=$((sl + 2))
    elif [ "$ttl" -ge 240 ] && [ "$ttl" -le 255 ]; then sn=$((sn + 2))
    fi

    # Ports
    for p in "${open_ports[@]}"; do
        case $p in 445) sw=$((sw + 3)) ;; 139|3389) sw=$((sw + 2)) ;; 22) sl=$((sl + 2)) ;; 23) sn=$((sn + 2)) ;; esac
    done

    # HTTP Server header
    header=$(echo -e "HEAD / HTTP/1.0\r\n\r\n" | timeout 1 nc "$ip" 80 2>/dev/null | grep -i "^Server:" | head -1)
    if [ -n "$header" ]; then
        echo "$header" | grep -qi "Microsoft-IIS" && sw=$((sw + 2))
        echo "$header" | grep -qiE "Apache|nginx" && sl=$((sl + 1))
    fi

    # NetBIOS name
    if command -v nmblookup >/dev/null 2>&1; then
        nb=$(nmblookup -A "$ip" 2>/dev/null | grep -E "<00>" | grep -v "<GROUP>" | head -1 | awk '{print $1}')
        [ -n "$nb" ] && sw=$((sw + 3))
    fi

    total=$((sw + sl + sn))
    [ "$total" -eq 0 ] && { echo "Unknown|low"; return; }

    if [ "$sw" -ge "$sl" ] && [ "$sw" -ge "$sn" ] && [ "$sw" -gt 0 ]; then os="Windows"; top=$sw
    elif [ "$sl" -ge "$sw" ] && [ "$sl" -ge "$sn" ] && [ "$sl" -gt 0 ]; then os="Linux / macOS / Mobile"; top=$sl
    elif [ "$sn" -gt 0 ]; then os="Cisco / Network Device"; top=$sn
    fi

    pct=$((top * 100 / total))
    [ "$pct" -ge 80 ] && conf="very high"
    [ "$pct" -ge 60 ] && conf="high"
    [ "$pct" -ge 40 ] && conf="medium"

    echo "$os|$conf"
}

# --- Loop-based end options (no recursion) ---
show_end_options() {
    local suppress_save="$1"
    shift
    local output_data=("$@")
    local action=""

    while true; do
        echo ""
        if [ "$suppress_save" = "true" ]; then
            read -r -p "$(echo -e "${CLR_CYAN}[+] Press Enter or 'B' for Main Menu, or 'E' to Exit:${CLR_RESET} ")" action
        else
            read -r -p "$(echo -e "${CLR_CYAN}[+] Press Enter or 'B' for Main Menu, 'S' to Save Scan, or 'E' to Exit:${CLR_RESET} ")" action
        fi

        case "$action" in
            [eE])
                echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"
                exit 0
                ;;
            [sS])
                if [ "$suppress_save" = "true" ]; then
                    start_neo_scanner
                    return
                fi
                if [ "${#output_data[@]}" -eq 0 ]; then
                    echo -e "  ${CLR_YELLOW}[-] No scan results available to save.${CLR_RESET}"
                else
                    local default_file="Scan_Result_$(date +'%Y%m%d_%H%M%S').txt"
                    local file_path=""

                    if command -v zenity >/dev/null 2>&1; then
                        file_path=$(zenity --file-selection --save --confirm-overwrite --filename="$default_file" 2>/dev/null)
                    elif command -v kdialog >/dev/null 2>&1; then
                        file_path=$(kdialog --getsavefilename "$default_file" 2>/dev/null)
                    fi

                    if [ -z "$file_path" ]; then
                        read -r -p "$(echo -e "${CLR_CYAN}Enter save file path (default: $default_file):${CLR_RESET} ")" user_path
                        file_path="${user_path:-$default_file}"
                    fi

                    printf "%s\n" "${output_data[@]}" > "$file_path" 2>/dev/null
                    if [ $? -eq 0 ]; then
                        echo -e "  ${CLR_GREEN}[+] Scan results saved to: $file_path${CLR_RESET}"
                    else
                        echo -e "  ${CLR_RED}[-] Error saving file to $file_path${CLR_RESET}"
                    fi
                fi
                ;;
            [bB]|"")
                start_neo_scanner
                return
                ;;
        esac
    done
}

