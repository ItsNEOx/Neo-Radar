#!/usr/bin/env bash
# ░▒▓█ NEO RADAR v1.11 █▓▒░

VERSION="1.11"
REPO_RAW_URL="https://raw.githubusercontent.com/ItsNEOx/Neo-Radar/main/neoradar"

# ANSI Color Codes
CLR_RESET="\033[0m"
CLR_CYAN="\033[1;36m"
CLR_DARKCYAN="\033[0;36m"
CLR_MAGENTA="\033[1;35m"
CLR_DARKMAGENTA="\033[0;35m"
CLR_YELLOW="\033[1;33m"
CLR_GREEN="\033[1;32m"
CLR_GRAY="\033[0;37m"
CLR_DARKGRAY="\033[1;30m"
CLR_RED="\033[1;31m"

DEFAULT_PREFIX="192.168.0"
COMMON_PORTS=(21 22 23 25 53 80 110 135 139 143 443 445 1433 3306 3389 5900 8080 8443)

show_end_options() {
    local suppress_save="$1"
    shift
    local output_data=("$@")
    local action=""

    echo ""
    if [ "$suppress_save" = "true" ]; then
        read -r -p "$(echo -e "${CLR_CYAN}[+] Press Enter or 'B' for Main Menu, or 'E' to Exit:${CLR_RESET} ")" action
    else
        read -r -p "$(echo -e "${CLR_CYAN}[+] Press Enter or 'B' for Main Menu, 'S' to Save Scan, or 'E' to Exit:${CLR_RESET} ")" action
    fi

    case "$action" in
        [eE])
            echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"
            exit 0
            ;;
        [sS])
            if [ "$suppress_save" = "true" ]; then
                start_neo_radar
                return
            fi

            if [ "${#output_data[@]}" -eq 0 ]; then
                echo -e "  ${CLR_YELLOW}[-] No scan results available to save.${CLR_RESET}"
            else
                local default_file="Scan_Result_$(date +'%Y%m%d_%H%M%S').txt"
                local file_path=""

                if command -v zenity >/dev/null 2>&1; then
                    file_path=$(zenity --file-selection --save --confirm-overwrite --filename="$default_file" 2>/dev/null)
                elif command -v kdialog >/dev/null 2>&1; then
                    file_path=$(kdialog --getsavefilename "$default_file" 2>/dev/null)
                fi

                if [ -z "$file_path" ]; then
                    read -r -p "$(echo -e "${CLR_CYAN}Enter save file path (default: $default_file):${CLR_RESET} ")" user_path
                    file_path="${user_path:-$default_file}"
                fi

                printf "%s\n" "${output_data[@]}" > "$file_path" 2>/dev/null
                if [ $? -eq 0 ]; then
                    echo -e "  ${CLR_GREEN}[+] Scan results successfully saved to: $file_path${CLR_RESET}"
                else
                    echo -e "  ${CLR_RED}[-] Error saving file to $file_path${CLR_RESET}"
                fi
            fi
            show_end_options "$suppress_save" "${output_data[@]}"
            ;;
        *)
            start_neo_radar
            ;;
    esac
}

# --- Tested Hostname Resolver ---
resolve_hostname() {
    local ip="$1"
    local name=""

    # 1. NetBIOS / Samba Lookup (nmblookup -A)
    if command -v nmblookup >/dev/null 2>&1; then
        name=$(nmblookup -A "$ip" 2>/dev/null | grep -iE "<00>|<20>" | grep -iv "<GROUP>" | head -n 1 | awk '{print $1}')
    fi

    # 2. mDNS / Avahi (.local)
    if [ -z "$name" ] && command -v avahi-resolve >/dev/null 2>&1; then
        name=$(avahi-resolve -a "$ip" 2>/dev/null | awk '{print $2}')
    fi

    # 3. Standard System / DNS Resolver
    if [ -z "$name" ]; then
        name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
    fi

    if [ -n "$name" ]; then
        echo "$name"
    else
        echo "No DNS/mDNS/NBT Record"
    fi
}

# --- Tested ARP MAC Capture ---
get_mac_address() {
    local ip="$1"
    local mac=""

    # Extract MAC from ip neighbor
    mac=$(ip neighbor show "$ip" 2>/dev/null | awk '{print $5}' | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'a-z' 'A-Z' | head -n 1)

    # Fallback to /proc/net/arp
    if [ -z "$mac" ] && [ -f /proc/net/arp ]; then
        mac=$(grep -w "$ip" /proc/net/arp 2>/dev/null | awk '{print $4}' | grep -v "00:00:00:00:00:00" | tr 'a-z' 'A-Z' | head -n 1)
    fi

    # Fallback to arp command
    if [ -z "$mac" ] && command -v arp >/dev/null 2>&1; then
        mac=$(arp -n "$ip" 2>/dev/null | grep -w "$ip" | awk '{print $3}' | grep -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'a-z' 'A-Z' | head -n 1)
    fi

    if [ -n "$mac" ]; then
        echo "$mac"
    else
        echo "Unavailable"
    fi
}

# --- Tested Local IEEE Vendor Lookup ---
get_vendor() {
    local mac="$1"
    [ -z "$mac" ] || [ "$mac" = "Unavailable" ] && { echo "Unknown Vendor"; return; }

    local oui_clean
    oui_clean=$(echo "$mac" | tr -d ':-' | tr 'a-z' 'A-Z' | cut -c 1-6)

    # Search local IEEE OUI file if present
    if [ -f /usr/share/ieee-data/oui.txt ]; then
        local match
        match=$(grep -i "^$oui_clean" /usr/share/ieee-data/oui.txt 2>/dev/null | head -n 1 | cut -d')' -f2 | xargs)
        if [ -n "$match" ]; then
            echo "$match"
            return
        fi
    fi

    # Fallback common OUI Table
    case "$oui_clean" in
        005056|000C29|000569|00155D) echo "VMware / Hyper-V" ;;
        080027|0A0027)               echo "Oracle VirtualBox" ;;
        B827EB|D43A04|E45F01|2CCF67) echo "Raspberry Pi" ;;
        001A11|3C5AB4|F4F5DB|DAA119) echo "Google" ;;
        000393|000502|A483E7|1093E9) echo "Apple" ;;
        50C7BF|E848B8|001D0F|98DAC4) echo "TP-Link" ;;
        00146C|00184D|288023|A42B8C) echo "NETGEAR" ;;
        00166F|001E64|A44E31|8086F2) echo "Intel" ;;
        *)                           echo "Unknown Vendor ($oui_clean)" ;;
    esac
}

check_port() {
    local ip="$1"
    local port="$2"
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 1 "$ip" "$port" >/dev/null 2>&1
    else
        timeout 1 bash -c "</dev/tcp/$ip/$port" >/dev/null 2>&1
    fi
    return $?
}

# --- Option 7: Check for Updates ---
check_for_updates() {
    echo -e "${CLR_CYAN}[+] Checking GitHub for updates...${CLR_RESET}"
    
    if ! command -v curl >/dev/null 2>&1; then
        echo -e "${CLR_RED}[-] Error: 'curl' is required to check for updates.${CLR_RESET}"
        show_end_options "true"
        return
    fi

    local remote_code
    remote_code=$(curl -sSL "$REPO_RAW_URL" 2>/dev/null)

    if [ -z "$remote_code" ]; then
        echo -e "${CLR_RED}[-] Could not reach GitHub repository. Check network connection.${CLR_RESET}"
        show_end_options "true"
        return
    fi

    local remote_version
    remote_version=$(echo "$remote_code" | grep -i '^VERSION=' | head -n 1 | cut -d'"' -f2)

    if [ -z "$remote_version" ]; then
        echo -e "${CLR_RED}[-] Could not parse remote version information.${CLR_RESET}"
        show_end_options "true"
        return
    fi

    echo -e "  Current Version: ${CLR_YELLOW}v$VERSION${CLR_RESET}"
    echo -e "  Latest Version : ${CLR_GREEN}v$remote_version${CLR_RESET}"

    if [ "$VERSION" = "$remote_version" ]; then
        echo -e "\n${CLR_GREEN}[+] You are running the latest version of NEO RADAR!${CLR_RESET}"
        show_end_options "true"
        return
    fi

    echo -e "\n${CLR_YELLOW}[!] A new update (v$remote_version) is available!${CLR_RESET}"
    read -r -p "$(echo -e "${CLR_CYAN}Would you like to download and update now? (y/N): ${CLR_RESET}")" update_choice

    case "$update_choice" in
        [yY][eE][sS]|[yY])
            echo -e "\n${CLR_CYAN}[+] Downloading update...${CLR_RESET}"
            local target_path="$0"
            
            if [ -w "$target_path" ]; then
                echo "$remote_code" > "$target_path"
                chmod +x "$target_path"
            else
                echo -e "${CLR_YELLOW}[!] Administrative privileges required to overwrite $target_path${CLR_RESET}"
                echo "$remote_code" | sudo tee "$target_path" >/dev/null
                sudo chmod +x "$target_path"
            fi

            echo -e "${CLR_GREEN}[+] Update complete! Restarting NEO RADAR...${CLR_RESET}"
            sleep 1.5
            exec "$target_path"
            ;;
        *)
            echo -e "${CLR_GRAY}[-] Update cancelled.${CLR_RESET}"
            show_end_options "true"
            ;;
    esac
}

start_neo_radar() {
    clear
    echo ""
    echo -e "${CLR_DARKMAGENTA}============================================${CLR_RESET}"
    echo -e "${CLR_CYAN}         ░▒▓█ NEO RADAR v$VERSION █▓▒░           ${CLR_RESET}"
    echo -e "${CLR_DARKMAGENTA}============================================${CLR_RESET}"
    echo -e "${CLR_MAGENTA}             Created By ItsNEOx             ${CLR_RESET}"
    echo -e "${CLR_DARKCYAN}      The super simple network scanner      ${CLR_RESET}"
    echo -e "${CLR_DARKGRAY}            for legal purposes              ${CLR_RESET}"
    echo -e "${CLR_DARKMAGENTA}--------------------------------------------${CLR_RESET}"
    echo ""

    echo -e "${CLR_CYAN}Choose scan mode:${CLR_RESET}"
    echo "1) Network Ping Scan"
    echo "2) Single Host Inspection (Ports + Hostname + OS)"
    echo "3) Ping + TCP port scan"
    echo "4) ARP Device MAC Lookup & Vendor Identification"
    echo "5) Hostname Scan & Fingerprinting"
    echo "6) Help / Feature Guide"
    echo "7) Check for Updates"
    echo "E) Exit Program"
    echo ""

    read -r -p "Enter option number or 'E' to Exit (default: 1): " mode
    [ -z "$mode" ] && mode=1

    case "$mode" in
        [eE])
            echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"
            exit 0
            ;;
    esac

    echo ""

    # Mode 7 — Update Check
    if [ "$mode" = "7" ]; then
        check_for_updates
        return
    fi

    # Mode 6 — Help
    if [ "$mode" = "6" ]; then
        echo -e "${CLR_DARKMAGENTA}============================================${CLR_RESET}"
        echo -e "${CLR_CYAN}          NEO RADAR - HELP & GUIDE          ${CLR_RESET}"
        echo -e "${CLR_DARKMAGENTA}============================================${CLR_RESET}"
        echo ""
        
        echo -e "${CLR_YELLOW}1) Network Ping Scan${CLR_RESET}"
        echo -e "${CLR_GRAY}   Multi-threaded ICMP sweep across a range of IPs to find online hosts.${CLR_RESET}\n"

        echo -e "${CLR_YELLOW}2) Single Host Inspection${CLR_RESET}"
        echo -e "${CLR_GRAY}   Checks Ping response, TTL OS estimation, DNS/mDNS/NBT hostnames,${CLR_RESET}"
        echo -e "${CLR_GRAY}   and scans key management ports.${CLR_RESET}\n"

        echo -e "${CLR_YELLOW}3) Ping + TCP Port Scan${CLR_RESET}"
        echo -e "${CLR_GRAY}   Discovers active hosts on the subnet, then attempts fast TCP handshakes.${CLR_RESET}\n"

        echo -e "${CLR_YELLOW}4) ARP Device MAC Lookup & Vendor Identification${CLR_RESET}"
        echo -e "${CLR_GRAY}   Queries kernel ARP tables to map IP addresses to physical MACs and Vendors.${CLR_RESET}\n"

        echo -e "${CLR_YELLOW}5) Hostname Scan & Fingerprinting${CLR_RESET}"
        echo -e "${CLR_GRAY}   Resolves DNS, mDNS, and NetBIOS hostnames, estimating OS based on ICMP TTL.${CLR_RESET}\n"

        echo -e "${CLR_YELLOW}7) Check for Updates${CLR_RESET}"
        echo -e "${CLR_GRAY}   Compares local script version against GitHub main branch and updates in place.${CLR_RESET}\n"

        echo -e "${CLR_YELLOW}HELP) Troubleshooting!${CLR_RESET}"
        echo -e "${CLR_GRAY}   For troubleshooting help, go to https://github.com/ItsNEOx/Neo-Radar/blob/main/README.md${CLR_RESET}\n"

        show_end_options "true"
        return
    fi

    # Mode 2 — Single Host Inspection
    if [ "$mode" = "2" ]; then
        echo -e "${CLR_DARKGRAY}Enter 'B' for Main Menu, or 'E' to Exit.${CLR_RESET}"
        read -r -p "Enter target IP address (Example : 192.168.0.1): " target_ip

        case "$target_ip" in
            [eE]) echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"; exit 0 ;;
            [bB]|"") start_neo_radar; return ;;
        esac

        echo -e "\n${CLR_CYAN}[+] Inspecting single host: $target_ip...${CLR_RESET}"

        ping_out=$(ping -c 1 -W 1 "$target_ip" 2>/dev/null)
        if [ $? -ne 0 ]; then
            echo -e "  ${CLR_YELLOW}[-] Host $target_ip did not respond to ping.${CLR_RESET}"
            show_end_options "false"
            return
        fi

        echo -e "  ${CLR_GREEN}[+] Host Status: ONLINE${CLR_RESET}"

        ttl=$(echo "$ping_out" | grep -i "ttl=" | sed -e 's/.*ttl=//i' | awk '{print $1}')
        os="Unknown"
        if [ -n "$ttl" ]; then
            if [ "$ttl" -ge 100 ] && [ "$ttl" -le 128 ]; then os="Windows"
            elif [ "$ttl" -ge 32 ] && [ "$ttl" -le 64 ]; then os="Linux / macOS / Mobile"
            elif [ "$ttl" -ge 240 ]; then os="Cisco / Network Device"
            fi
        else
            ttl="N/A"
        fi

        host_name=$(resolve_hostname "$target_ip")

        echo -e "  ${CLR_CYAN}[+] Scanning ${#COMMON_PORTS[@]} common ports...${CLR_RESET}"
        
        tmp_dir=$(mktemp -d)
        for port in "${COMMON_PORTS[@]}"; do
            (
                if check_port "$target_ip" "$port"; then
                    echo "$port" > "$tmp_dir/$port"
                fi
            ) &
        done
        wait

        open_ports=()
        for port in "${COMMON_PORTS[@]}"; do
            if [ -f "$tmp_dir/$port" ]; then
                open_ports+=("$port")
            fi
        done
        rm -rf "$tmp_dir"

        echo -e "\n${CLR_DARKMAGENTA}--------------------------------------------${CLR_RESET}"
        echo -e "${CLR_CYAN} Host Details: $target_ip${CLR_RESET}"
        echo -e "${CLR_DARKMAGENTA}--------------------------------------------${CLR_RESET}"
        echo -e "  ${CLR_GREEN}Hostname : $host_name${CLR_RESET}"
        echo -e "  ${CLR_GREEN}OS Family: $os (TTL: $ttl)${CLR_RESET}"

        if [ "${#open_ports[@]}" -gt 0 ]; then
            ports_text=$(IFS=', '; echo "${open_ports[*]}")
            echo -e "  ${CLR_GREEN}Open Ports: $ports_text${CLR_RESET}"
        else
            ports_text="No open ports found (checked ${#COMMON_PORTS[@]} common ports)"
            echo -e "  ${CLR_DARKGRAY}Open Ports: $ports_text${CLR_RESET}"
        fi

        scan_log=(
            "============================================"
            " NEO RADAR - Single Host Inspection Log"
            " Timestamp : $(date)"
            " Target IP : $target_ip"
            " Hostname  : $host_name"
            " OS Family : $os (TTL: $ttl)"
            " Open Ports: $ports_text"
            "============================================"
        )

        show_end_options "false" "${scan_log[@]}"
        return
    fi

    # Subnet Prompt (Modes 1, 3, 4, 5)
    echo -e "${CLR_DARKGRAY}Enter 'B' for Main Menu, or 'E' to Exit.${CLR_RESET}"
    read -r -p "Enter target network prefix (default: $DEFAULT_PREFIX): " prefix_input

    case "$prefix_input" in
        [eE]) echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"; exit 0 ;;
        [bB]) start_neo_radar; return ;;
    esac
    prefix="${prefix_input:-$DEFAULT_PREFIX}"

    read -r -p "Enter starting host number (default: 1): " start_input
    case "$start_input" in
        [eE]) echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"; exit 0 ;;
        [bB]) start_neo_radar; return ;;
    esac
    start_host="${start_input:-1}"

    read -r -p "Enter ending host number (default: 254): " end_input
    case "$end_input" in
        [eE]) echo -e "\n${CLR_CYAN}Goodbye.${CLR_RESET}"; exit 0 ;;
        [bB]) start_neo_radar; return ;;
    esac
    end_host="${end_input:-254}"

    echo -e "\n${CLR_CYAN}[+] Starting live sweep on $prefix.$start_host through $prefix.$end_host...${CLR_RESET}"
    echo -e "${CLR_DARKMAGENTA}--------------------------------------------${CLR_RESET}"

    tmp_ping_dir=$(mktemp -d)

    for (( i=start_host; i<=end_host; i++ )); do
        (
            ip="$prefix.$i"
            ping_res=$(ping -c 1 -W 1 "$ip" 2>/dev/null)
            if [ $? -eq 0 ]; then
                rtt=$(echo "$ping_res" | grep -i "time=" | sed -e 's/.*time=//i' | awk '{print $1}')
                [ -z "$rtt" ] && rtt="<1"
                echo "$rtt" > "$tmp_ping_dir/$i"
                echo -e "  ${CLR_GREEN}[+] Discovered: $ip [RTT: ${rtt}ms]${CLR_RESET}"
            fi
        ) &
        
        running_jobs=$(jobs -r -p | wc -l)
        if [ "$running_jobs" -ge 64 ]; then
            sleep 0.02
        fi
    done
    wait

    alive=()
    for (( i=start_host; i<=end_host; i++ )); do
        if [ -f "$tmp_ping_dir/$i" ]; then
            alive+=("$prefix.$i")
        fi
    done
    rm -rf "$tmp_ping_dir"

    echo -e "${CLR_DARKMAGENTA}--------------------------------------------${CLR_RESET}"
    echo -e "${CLR_CYAN}Sweep Complete. Total Active Hosts: ${#alive[@]}${CLR_RESET}"

    if [ "${#alive[@]}" -eq 0 ]; then
        echo -e "  ${CLR_YELLOW}[-] No hosts responded.${CLR_RESET}"
        show_end_options "false" "No active hosts discovered on $prefix.$start_host-$end_host"
        return
    fi

    # Mode 1 — Network Ping Scan
    if [ "$mode" = "1" ]; then
        echo -e "\n${CLR_CYAN}Sorted Active Hosts:${CLR_RESET}"
        for h in "${alive[@]}"; do
            echo -e "  ${CLR_GREEN}[+] $h${CLR_RESET}"
        done

        scan_log=(
            "============================================"
            " NEO RADAR - Network Ping Scan Log"
            " Timestamp : $(date)"
            " Target    : $prefix.$start_host-$end_host"
            " Total     : ${#alive[@]} active hosts"
            "--------------------------------------------"
        )
        for h in "${alive[@]}"; do scan_log+=("  [+] $h"); done
        scan_log+=("============================================")

        show_end_options "false" "${scan_log[@]}"
        return
    fi

    # Mode 3 — Ping + TCP port scan
    if [ "$mode" = "3" ]; then
        echo -e "\n${CLR_CYAN}[+] Scanning ${#COMMON_PORTS[@]} common TCP ports across active hosts...${CLR_RESET}"

        tmp_port_dir=$(mktemp -d)

        for target in "${alive[@]}"; do
            for port in "${COMMON_PORTS[@]}"; do
                (
                    if check_port "$target" "$port"; then
                        echo "OPEN" > "$tmp_port_dir/${target}_${port}"
                    fi
                ) &

                running_jobs=$(jobs -r -p | wc -l)
                if [ "$running_jobs" -ge 100 ]; then
                    sleep 0.01
                fi
            done
        done
        wait

        echo -e "\n${CLR_CYAN}TCP Port Scan Results (Open Ports Only):${CLR_RESET}"

        scan_log=(
            "============================================"
            " NEO RADAR - Ping + TCP Port Scan Log"
            " Timestamp : $(date)"
            " Target    : $prefix.$start_host-$end_host"
            " Scanned   : ${#COMMON_PORTS[@]} Common Ports"
            "--------------------------------------------"
        )

        for target in "${alive[@]}"; do
            echo -e "\n${CLR_YELLOW}Host: $target${CLR_RESET}"
            echo -e "${CLR_DARKMAGENTA}-------------------------${CLR_RESET}"
            scan_log+=("" "Host: $target")

            has_open=0
            for port in "${COMMON_PORTS[@]}"; do
                if [ -f "$tmp_port_dir/${target}_${port}" ]; then
                    echo -e "  ${CLR_GREEN}[+] Port $port : OPEN${CLR_RESET}"
                    scan_log+=("  [+] Port $port : OPEN")
                    has_open=1
                fi
            done

            if [ "$has_open" -eq 0 ]; then
                echo -e "  ${CLR_DARKGRAY}[-] No open target ports found.${CLR_RESET}"
                scan_log+=("  [-] No open target ports found.")
            fi
        done
        scan_log+=("============================================")
        rm -rf "$tmp_port_dir"

        show_end_options "false" "${scan_log[@]}"
        return
    fi

    # Mode 4 — Fast ARP Device Identification & Vendor Lookup
    if [ "$mode" = "4" ]; then
        echo -e "\n${CLR_CYAN}[+] Refreshing ARP entries for active targets...${CLR_RESET}"

        # Send unicast ping to ensure ARP table populates in the Linux kernel
        for ip in "${alive[@]}"; do
            ping -c 2 -W 1 "$ip" >/dev/null 2>&1 &
        done
        wait
        sleep 0.2

        echo -e "\n${CLR_CYAN}Device MAC Addresses & Manufacturer Identification:${CLR_RESET}"

        scan_log=(
            "============================================"
            " NEO RADAR - MAC Lookup & Vendor ID Log"
            " Timestamp : $(date)"
            " Target    : $prefix.$start_host-$end_host"
            "--------------------------------------------"
        )

        for ip in "${alive[@]}"; do
            mac=$(get_mac_address "$ip")
            vendor=$(get_vendor "$mac")

            if [ "$mac" != "Unavailable" ]; then
                echo -e "  ${CLR_GREEN}$ip  ->  $mac  [$vendor]${CLR_RESET}"
                scan_log+=("  $ip  ->  $mac  [$vendor]")
            else
                echo -e "  ${CLR_DARKGRAY}$ip  ->  MAC Unavailable${CLR_RESET}"
                scan_log+=("  $ip  ->  MAC Unavailable")
            fi
        done
        scan_log+=("============================================")

        show_end_options "false" "${scan_log[@]}"
        return
    fi

    # Mode 5 — Hostname Scan & Fingerprinting
    if [ "$mode" = "5" ]; then
        echo -e "\n${CLR_CYAN}[+] Resolving Hostnames & OS Profiling...${CLR_RESET}"

        tmp_host_dir=$(mktemp -d)

        for target in "${alive[@]}"; do
            (
                host_name=$(resolve_hostname "$target")

                ping_out=$(ping -c 1 -W 1 "$target" 2>/dev/null)
                ttl=$(echo "$ping_out" | grep -i "ttl=" | sed -e 's/.*ttl=//i' | awk '{print $1}')
                
                os="Unknown"
                if [ -n "$ttl" ]; then
                    if [ "$ttl" -ge 100 ] && [ "$ttl" -le 128 ]; then os="Windows"
                    elif [ "$ttl" -ge 32 ] && [ "$ttl" -le 64 ]; then os="Linux / macOS / Mobile"
                    elif [ "$ttl" -ge 240 ]; then os="Cisco / Network Device"
                    fi
                fi

                echo "Host: $host_name | OS: $os" > "$tmp_host_dir/$target"
            ) &
        done
        wait

        echo -e "\n${CLR_CYAN}Hostname & OS Results:${CLR_RESET}"

        scan_log=(
            "============================================"
            " NEO RADAR - Hostname Scan & Fingerprinting Log"
            " Timestamp : $(date)"
            " Target    : $prefix.$start_host-$end_host"
            "--------------------------------------------"
        )

        for target in "${alive[@]}"; do
            if [ -f "$tmp_host_dir/$target" ]; then
                details=$(cat "$tmp_host_dir/$target")
                echo -e "  ${CLR_GREEN}$target -> $details${CLR_RESET}"
                scan_log+=("  $target -> $details")
            fi
        done
        scan_log+=("============================================")
        rm -rf "$tmp_host_dir"

        show_end_options "false" "${scan_log[@]}"
        return
    fi

    show_end_options "false"
}

start_neo_radar
